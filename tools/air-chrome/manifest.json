{
  "manifest_version": 3,
  "name": "ETC Air",
  "version": "1.0.0",
  "description": "Control any web page with hand gestures from the ETC Air Apple Watch app.",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://smb31202-etc.netlify.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "ETC Air: click to switch on or off" },
  "icons": { "128": "icon128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["air-content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
